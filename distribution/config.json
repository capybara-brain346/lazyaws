{
  "name": "lazyaws",
  "repository": "capybara-brain346/lazyaws",
  "homepage": "https://lazyaws.xyz",
  "downloadBaseUrl": "https://github.com/capybara-brain346/lazyaws/releases/download",
  "latestUrl": "https://github.com/capybara-brain346/lazyaws/releases/latest",
  "tap": "capybara-brain346/tap",
  "aurPackage": "lazyaws-bin",
  "installDir": ".local/bin",
  "connectTimeoutSeconds": 10,
  "downloadTimeoutSeconds": 120,
  "demoCheckTimeoutSeconds": 15,
  "demoCheckRows": 24,
  "demoCheckColumns": 80,
  "minimumUbuntuVersion": "24.04",
  "minimumMacosVersion": "15.0",
  "minimumMacosRelease": "sequoia",
  "targets": [
    { "triple": "aarch64-apple-darwin", "runner": "macos-15", "os": "darwin", "arch": "arm64" },
    { "triple": "x86_64-apple-darwin", "runner": "macos-15-intel", "os": "darwin", "arch": "x86_64" },
    { "triple": "aarch64-unknown-linux-gnu", "runner": "ubuntu-24.04-arm", "os": "linux", "arch": "aarch64" },
    { "triple": "x86_64-unknown-linux-gnu", "runner": "ubuntu-24.04", "os": "linux", "arch": "x86_64" }
  ]
}
