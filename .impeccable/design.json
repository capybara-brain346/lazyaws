  "narrative": {
    "northStar": "A terminal in a night landscape",
    "overview": "Dark navy surfaces and a quiet landscape frame the real terminal. Pale text supports long reading. Apricot marks actions and selected controls. The landscape adds depth; actual demo captures show the product.\n\nThe page has open space around headings and compact detail inside terminal and command panels. Local fonts keep the same type across visits.",
    "keyCharacteristics": [
      "Dark navy surfaces with pale text.",
      "Apricot actions and selected controls.",
      "Real terminal captures with full-size links.",
      "Open section spacing and compact command panels."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Use apricot for actions, selection, and focus. Use neutral colors for large text areas and panel fills.",
        "section": "colors"
      },
      {
        "name": "The Code Type Rule",
        "body": "Use the mono face for commands, step numbers, and terminal labels. Use Manrope for explanatory text.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use real demo captures to explain the terminal.",
      "**Do** keep commands in the mono face.",
      "**Do** provide visible keyboard focus and full-size capture links.",
      "**Do** keep the reduced-motion behavior."
    ],
    "donts": [
      "**Don't** use apricot as a large panel fill.",
      "**Don't** add the large terminal shadow to every panel.",
      "**Don't** stretch terminal captures or place them in narrow fixed-width boxes."
    ]
  }
